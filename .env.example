# このファイルを .env という名前でコピーして、実際の値を入れてください。
# .env はGitには含めません（.gitignoreで除外済み）。

# Google AI Studio (https://aistudio.google.com/apikey) で発行したAPIキー
GEMINI_API_KEY=your_api_key_here

# 使用するGeminiモデル（省略時は gemini-flash-lite-latest）
# GEMINI_MODEL=gemini-flash-lite-latest

# 「売却検討」の新規判定をメール通知したい場合のみ設定（任意）
# 送信元Gmailアドレスと、そのアカウントで発行した「アプリパスワード」
# GMAIL_ADDRESS=your_gmail_address@gmail.com
# GMAIL_APP_PASSWORD=your_16_char_app_password
# 通知の宛先（省略時はGMAIL_ADDRESS宛に送信）
# NOTIFY_TO_EMAIL=your_notify_address@example.com
