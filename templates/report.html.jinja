<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>AI投資分析ダッシュボード</title>
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="AI投資分析">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="theme-color" content="#f9f9f7" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)">
<style>
  :root {
    color-scheme: light;
    --page:           #f9f9f7;
    --surface-1:      #fcfcfb;
    --text-primary:   #0b0b0b;
    --text-secondary: #52514e;
    --text-muted:     #898781;
    --gridline:       #e1e0d9;
    --baseline:       #c3c2b7;
    --border:         rgba(11,11,11,0.10);
    --status-good:     #0ca30c;
    --status-warning:  #fab219;
    --status-critical: #d03b3b;
    --series-1:        #2a78d6;
  }
  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme="light"])) {
      color-scheme: dark;
      --page:           #0d0d0d;
      --surface-1:      #1a1a19;
      --text-primary:   #ffffff;
      --text-secondary: #c3c2b7;
      --text-muted:     #898781;
      --gridline:       #2c2c2a;
      --baseline:       #383835;
      --border:         rgba(255,255,255,0.10);
      --series-1:       #3987e5;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --page:           #0d0d0d;
    --surface-1:      #1a1a19;
    --text-primary:   #ffffff;
    --text-secondary: #c3c2b7;
    --text-muted:     #898781;
    --gridline:       #2c2c2a;
    --baseline:       #383835;
    --border:         rgba(255,255,255,0.10);
    --series-1:       #3987e5;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    background: var(--page);
    color: var(--text-primary);
    line-height: 1.6;
  }
  .wrap {
    max-width: 880px;
    margin: 0 auto;
    padding: 24px 16px 64px;
  }
  header.top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  h1 { font-size: 1.4rem; margin: 0; }
  .updated { color: var(--text-muted); font-size: 0.85rem; }
  .theme-toggle {
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 0.8rem;
    cursor: pointer;
  }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }
  /* 上部に固定される目次バー。スマホでは横にスクロールして全セクションを選べる */
  .section-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    margin: 12px -16px 0;
    padding: 8px 16px;
    background: var(--page);
    border-bottom: 1px solid var(--gridline);
  }
  .section-nav::-webkit-scrollbar { display: none; }
  .section-nav a {
    flex: none;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-secondary);
    border-radius: 999px;
    padding: 5px 12px;
    font-size: 0.82rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .section-nav a:hover { color: var(--text-primary); }
  .section-nav a.active { background: var(--text-primary); color: var(--page); border-color: var(--text-primary); }
  .section-nav a:focus-visible { outline: 2px solid var(--series-1); outline-offset: 2px; }
  .nav-badge {
    font-size: 0.7rem;
    color: var(--status-critical);
    font-weight: 600;
  }
  .section-nav a.active .nav-badge { color: inherit; }
  section[id], .card[id] { scroll-margin-top: 64px; }

  .disclaimer {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 4px solid var(--status-warning);
    border-radius: 8px;
    padding: 10px 14px;
    margin: 12px 0 0;
    font-size: 0.82rem;
    color: var(--text-secondary);
  }
  .disclaimer strong { color: var(--text-primary); }

  .cards-hint { font-size: 0.78rem; color: var(--text-muted); margin: 14px 0 0; }
  .empty-note { color: var(--text-muted); font-size: 0.9rem; }

  section { margin: 28px 0 36px; }
  h2 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
    font-size: 1.12rem;
    color: var(--text-primary);
    border-bottom: 2px solid var(--gridline);
    padding-bottom: 8px;
    margin: 0 0 14px;
  }
  .h2-count { font-size: 0.8rem; font-weight: 400; color: var(--text-muted); }
  .sub-heading { font-size: 1rem; margin: 26px 0 10px; }

  /* セクションの注意書き。1行の要点だけを見せ、詳細は押すと開く */
  .section-note {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 4px solid var(--baseline);
    border-radius: 8px;
    padding: 9px 14px;
    margin-bottom: 14px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }
  .section-note.info { border-left-color: var(--series-1); }
  .section-note.warn { border-left-color: var(--status-critical); }
  .section-note > summary { cursor: pointer; color: var(--text-primary); font-weight: 600; }
  .section-note[open] > summary { margin-bottom: 6px; }
  .section-note ul { margin: 6px 0 0; padding-left: 1.2em; }
  .note-detail { margin-top: 8px; font-size: 0.82rem; color: var(--text-secondary); }
  .note-detail > summary { cursor: pointer; color: var(--text-muted); }
  .note-detail[open] > summary { margin-bottom: 4px; }
  .note-detail ul { padding-left: 1.2em; }

  .macro-list { list-style: none; padding: 0; margin: 0; }
  .macro-list li {
    padding: 8px 0;
    border-bottom: 1px solid var(--gridline);
    font-size: 0.9rem;
  }
  .macro-list li:last-child { border-bottom: none; }
  .macro-list a { color: var(--text-primary); text-decoration: none; }
  .macro-list a:hover { text-decoration: underline; }
  .macro-source { color: var(--text-muted); font-size: 0.8rem; }

  .card-list { display: flex; flex-direction: column; gap: 10px; }
  .card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 4px solid var(--status-color, var(--baseline));
    border-radius: 10px;
  }
  /* 折りたたみカードの見出し部分（閉じていても要点が分かるようにする） */
  .card-summary {
    display: block;
    position: relative;
    padding: 12px 40px 12px 14px;
    cursor: pointer;
    list-style: none;
  }
  .card-summary::-webkit-details-marker { display: none; }
  .card-summary:hover { background: var(--page); border-radius: 10px; }
  .card-summary:focus-visible { outline: 2px solid var(--series-1); outline-offset: -2px; border-radius: 10px; }
  .cs-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 4px 10px;
    flex-wrap: wrap;
  }
  .cs-title { min-width: 0; }
  .cs-title .rank { margin-right: 6px; }
  .cs-status { display: flex; align-items: center; gap: 10px; flex: none; }
  .cs-score {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    font-size: 1.05rem;
    min-width: 2.6em;
    text-align: right;
    color: var(--status-color, var(--text-secondary));
  }
  .card.status-warning .cs-score, .card.status-muted .cs-score { color: var(--text-secondary); }
  .cs-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px 14px;
    margin-top: 4px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .cs-meta .label { color: var(--text-muted); margin-right: 4px; }
  .cs-meta .horizon-tag { margin-left: 0; }
  .cs-gain { font-size: 0.95rem; }
  .cs-reason {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* 「>」で自分自身の見出しだけに限定する（業種カードの中に入れ子にした銘柄カードに影響させない） */
  .card[open] > .card-summary .cs-reason { display: none; }
  .cs-toggle {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 18px;
    text-align: center;
  }
  .cs-toggle::before { content: "▾"; }
  .card[open] > .card-summary .cs-toggle::before { content: "▴"; }
  .card-body { padding: 0 14px 14px; border-top: 1px solid var(--gridline); }
  .tag-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tag-row .market-tag, .tag-row .theme-tag, .tag-row .nisa-tag { margin-left: 0; }
  .price-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(118px, 1fr));
    gap: 4px 12px;
    margin: 8px 0 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .price-grid .label { color: var(--text-muted); margin-right: 4px; font-size: 0.78rem; }
  .card.status-good     { --status-color: var(--status-good); }
  .card.status-warning  { --status-color: var(--status-warning); }
  .card.status-critical { --status-color: var(--status-critical); }
  .card.status-muted    { --status-color: var(--text-muted); }

  .rank { color: var(--text-muted); font-size: 0.8rem; font-variant-numeric: tabular-nums; }
  .name { font-weight: 600; font-size: 1rem; }
  .symbol { color: var(--text-muted); font-size: 0.85rem; font-weight: 400; }
  .market-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--text-muted);
    border: 1px solid var(--gridline);
    border-radius: 4px;
    padding: 1px 6px;
    margin-left: 6px;
  }
  .theme-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--text-secondary);
    background: var(--page);
    border: 1px solid var(--gridline);
    border-radius: 4px;
    padding: 1px 6px;
    margin-left: 6px;
  }
  .nisa-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--text-secondary);
    border: 1px solid var(--gridline);
    border-radius: 4px;
    padding: 1px 6px;
    margin-left: 6px;
  }

  .yutai-box {
    border: 1px solid var(--gridline);
    border-radius: 8px;
    padding: 10px 12px;
    margin: 4px 0 12px;
    font-size: 0.85rem;
  }
  .yutai-content { color: var(--text-primary); margin-bottom: 8px; }
  .yutai-content .label { color: var(--text-muted); margin-right: 4px; }
  .yutai-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 8px 16px;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }
  .yutai-stats .label { display: block; font-size: 0.72rem; color: var(--text-muted); }
  .yutai-flag {
    display: inline-block;
    font-size: 0.72rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 8px;
    margin-left: 4px;
    white-space: nowrap;
  }
  .range-meter {
    position: relative;
    height: 6px;
    margin-top: 5px;
    border-radius: 3px;
    background: var(--gridline);
  }
  .range-meter-dot {
    position: absolute;
    top: 50%;
    width: 10px;
    height: 10px;
    margin-left: -5px;
    border-radius: 50%;
    background: var(--series-1);
    border: 2px solid var(--surface-1);
    transform: translateY(-50%);
  }
  .range-meter-ends { display: flex; justify-content: space-between; font-size: 0.68rem; color: var(--text-muted); margin-top: 2px; }

  .summary-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 560px) {
    .summary-grid { grid-template-columns: 1fr; }
  }
  .summary-horizon + .summary-horizon {
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--gridline);
  }
  .summary-horizon-title { font-size: 0.95rem; margin: 0 0 2px; }
  .summary-horizon-note { font-size: 0.78rem; color: var(--text-muted); margin: 0 0 10px; }
  .horizon-tag {
    display: inline-block;
    font-size: 0.72rem;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0 8px;
    margin-left: 6px;
    white-space: nowrap;
  }
  .summary-heading {
    font-size: 0.85rem;
    font-weight: 600;
    margin: 0 0 8px;
  }
  .summary-heading.buy { color: var(--status-good); }
  .summary-heading.sell { color: var(--status-critical); }
  .summary-list {
    list-style: none;
    margin: 0;
    padding: 0;
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .summary-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 1px solid var(--gridline);
    font-size: 0.85rem;
  }
  .summary-list li:last-child .summary-link { border-bottom: none; }
  .summary-link:hover { background: var(--page); }
  .summary-score {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    width: 3em;
    flex: none;
  }
  .summary-score.buy { color: var(--status-good); }
  .summary-score.sell { color: var(--status-critical); }
  .summary-name { font-weight: 600; }
  .summary-group {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.72rem;
    flex: none;
  }
  .summary-count { font-size: 0.75rem; font-weight: 400; color: var(--text-muted); margin-left: 4px; }
  .subscores {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    margin: -4px 0 12px;
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }
  .subscores .label { color: var(--text-muted); margin-right: 4px; font-size: 0.78rem; }
  .cs-pick { color: var(--text-primary); }
  .cs-pick strong { color: var(--status-good); }
  .member-block {
    margin: 12px 0 14px;
    padding: 10px 12px 12px;
    background: var(--page);
    border: 1px solid var(--gridline);
    border-radius: 8px;
  }
  .member-heading { margin: 0; font-size: 0.9rem; }
  .member-note { margin: 2px 0 10px; font-size: 0.75rem; color: var(--text-muted); }
  .member-block .card-list { gap: 8px; }
  .buy-heading { color: var(--status-good); margin-top: 4px; }
  .group-more { margin-top: 14px; }
  .group-more > summary {
    cursor: pointer;
    font-size: 0.88rem;
    color: var(--text-secondary);
    padding: 10px 14px;
    border: 1px dashed var(--border);
    border-radius: 8px;
  }
  .group-more[open] > summary { margin-bottom: 10px; }
  .yutai-source { margin: 8px 0 0; font-size: 0.75rem; color: var(--text-muted); }
  .yutai-source a { color: var(--series-1); margin-left: 6px; }
  .summary-empty {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }
  .summary-note {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin: 10px 0 0;
  }

  .gain-up { color: var(--status-good); }
  .gain-down { color: var(--status-critical); }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--status-color, var(--text-muted));
    flex: none;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 10px 0;
  }
  .score-value {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    width: 3.5em;
    text-align: right;
  }
  .score-track {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--gridline);
    overflow: hidden;
  }
  .score-fill {
    height: 100%;
    background: var(--status-color, var(--baseline));
  }

  .allocation-box {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    margin: 0 0 18px;
  }
  .allocation-box h3 { margin: 0 0 10px; font-size: 1rem; }
  .allocation-row {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 6px 0;
    font-size: 0.85rem;
  }
  .allocation-label {
    width: 9em;
    flex-shrink: 0;
    color: var(--text-secondary);
  }
  .allocation-amount {
    min-width: 7em;
    flex-shrink: 0;
    text-align: right;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
  }
  .allocation-note { color: var(--text-muted); font-size: 0.8rem; margin: 8px 0 0; }
  .allocation-amount { white-space: nowrap; }
  @media (max-width: 560px) {
    /* スマホでは項目名を1行目、バーと数値を2行目に置き、数値の折り返しを防ぐ */
    .allocation-row { flex-wrap: wrap; row-gap: 2px; margin: 10px 0; }
    .allocation-label { width: 100%; }
    .allocation-amount { width: auto; min-width: 4em; }
  }
  .kv-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 12px;
    padding: 7px 0;
    border-bottom: 1px solid var(--gridline);
    font-size: 0.88rem;
  }
  .kv-row:last-of-type { border-bottom: none; }
  .kv-label { color: var(--text-secondary); }
  .kv-value { font-variant-numeric: tabular-nums; text-align: right; }
  .kv-sub { display: block; font-size: 0.75rem; color: var(--text-muted); }
  .kv-total .kv-label { color: var(--text-primary); }


  .price-chart { margin: 4px 0 14px; }
  .price-chart-title { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 4px; }
  .price-chart-plot {
    position: relative;
    height: 120px;
    border-bottom: 1px solid var(--baseline);
    cursor: crosshair;
    touch-action: pan-y;
    outline: none;
  }
  .price-chart-plot:focus-visible { box-shadow: 0 0 0 2px var(--series-1); border-radius: 2px; }
  .price-chart-plot svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .price-line {
    fill: none;
    stroke: var(--series-1);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .purchase-line { stroke: var(--text-secondary); stroke-width: 1; stroke-dasharray: 4 3; }
  .purchase-label {
    position: absolute;
    left: 0;
    transform: translateY(-115%);
    font-size: 0.7rem;
    color: var(--text-secondary);
    pointer-events: none;
  }
  .purchase-label.below { transform: translateY(15%); }
  .purchase-date-line {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dotted var(--text-muted);
    pointer-events: none;
  }
  .purchase-date-label {
    position: absolute;
    top: 0;
    padding-left: 3px;
    font-size: 0.7rem;
    color: var(--text-muted);
    pointer-events: none;
  }
  .chart-crosshair {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--text-muted);
    display: none;
    pointer-events: none;
  }
  .chart-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--series-1);
    box-shadow: 0 0 0 2px var(--surface-1);
    transform: translate(-50%, -50%);
    display: none;
    pointer-events: none;
  }
  .chart-tooltip {
    position: absolute;
    top: -6px;
    transform: translate(-50%, -100%);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 0.75rem;
    white-space: nowrap;
    box-shadow: 0 2px 6px rgba(0,0,0,0.12);
    display: none;
    pointer-events: none;
    z-index: 5;
  }
  .chart-tooltip strong { display: block; color: var(--text-primary); font-variant-numeric: tabular-nums; }
  .chart-tooltip span { color: var(--text-secondary); }
  .price-chart-axis {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 3px;
    font-size: 0.7rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .reasoning { font-size: 0.92rem; margin: 8px 0; }
  .risks { font-size: 0.85rem; color: var(--text-secondary); }
  .risks .label { color: var(--text-muted); }
  .reflection {
    font-size: 0.85rem;
    color: var(--text-secondary);
    font-style: italic;
    border-left: 2px solid var(--border);
    padding-left: 8px;
    margin: 8px 0;
  }

  .factors {
    list-style: none;
    padding: 0;
    margin: 8px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .factors li {
    font-size: 0.78rem;
    background: var(--page);
    border: 1px solid var(--gridline);
    border-radius: 999px;
    padding: 3px 10px;
    color: var(--text-secondary);
  }

  details.news-detail { margin-top: 10px; font-size: 0.82rem; }
  details.news-detail summary {
    cursor: pointer;
    color: var(--text-muted);
  }
  details.news-detail ul { margin: 8px 0 0; padding-left: 18px; }
  details.news-detail a { color: var(--text-primary); }

  footer {
    color: var(--text-muted);
    font-size: 0.78rem;
    text-align: center;
    margin-top: 40px;
    border-top: 1px solid var(--gridline);
    padding-top: 16px;
  }

  .back-to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--surface-1);
    color: var(--text-primary);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s, visibility 0.2s;
    z-index: 100;
  }
  .back-to-top.visible { opacity: 1; visibility: visible; }
  .back-to-top:hover { background: var(--gridline); }
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <h1>AI投資分析ダッシュボード</h1>
    <button class="theme-toggle" id="theme-toggle" type="button">☀︎ / ☾ 切替</button>
  </header>
  <div class="updated">最終更新: {{ generated_at }}</div>

  <div class="disclaimer">
    <strong>⚠ AIによる自動分析で、投資助言・推奨ではありません。</strong>
    投資の最終判断は、必ずご自身の責任で行ってください。
    <details class="note-detail">
      <summary>免責事項の全文</summary>
      本サイトの内容はAIによる自動分析であり、投資助言・推奨ではありません。
      表示されるスコア・推奨・理由は、公開されている株価データとニュース見出しをもとに
      AIが機械的に整理した参考情報に過ぎず、正確性・完全性を保証するものではありません。
      投資に関する最終判断は、必ずご自身の責任で行ってください。
    </details>
  </div>

  {% set holding_sell_count = holdings|selectattr("recommendation", "equalto", "売却検討")|list|length %}
  <nav class="section-nav" id="section-nav" aria-label="セクションへ移動">
    <a href="#summary">サマリー</a>
    <a href="#holdings">保有銘柄{% if holding_sell_count %} <span class="nav-badge">売却検討{{ holding_sell_count }}</span>{% endif %}</a>
    <a href="#sectors">業種別</a>
    <a href="#yutai">株主優待</a>
    <a href="#watchlist">ウォッチリスト</a>
    <a href="#candidates">注目テーマ</a>
    <a href="#crypto">暗号資産</a>
    <a href="#news">ニュース</a>
    <a href="#accuracy">的中率</a>
  </nav>

  {% macro price_chart(c, name) %}
    {% if c %}
    <div class="price-chart" data-points="{{ c.points_json }}" data-height="{{ c.height }}">
      <div class="price-chart-title">1年の株価推移（週次）</div>
      <div class="price-chart-plot" tabindex="0"
           aria-label="{{ name }}の1年の株価推移。{{ c.start_date }}から{{ c.end_date }}、最高値{{ c.max_display }}、最安値{{ c.min_display }}、直近{{ c.latest_display }}{% if c.purchase_display %}、取得単価{{ c.purchase_display }}{% endif %}。左右キーで日付ごとの値を確認できます。">
        <svg viewBox="0 0 {{ c.width }} {{ c.height }}" preserveAspectRatio="none" aria-hidden="true">
          {% if c.purchase_y is not none %}
          <line class="purchase-line" x1="0" x2="{{ c.width }}" y1="{{ c.purchase_y }}" y2="{{ c.purchase_y }}" vector-effect="non-scaling-stroke"></line>
          {% endif %}
          <path class="price-line" d="{{ c.path }}" vector-effect="non-scaling-stroke"></path>
        </svg>
        {% if c.purchase_y_pct is not none %}
        <span class="purchase-label{% if c.purchase_y_pct < 20 %} below{% endif %}" style="top: {{ c.purchase_y_pct }}%;">取得単価 {{ c.purchase_display }}</span>
        {% endif %}
        {% if c.purchase_x_pct is not none %}
        <div class="purchase-date-line" style="left: {{ c.purchase_x_pct }}%;"></div>
        <span class="purchase-date-label" style="left: {{ c.purchase_x_pct }}%;">購入</span>
        {% endif %}
        <div class="chart-crosshair"></div>
        <div class="chart-dot"></div>
        <div class="chart-tooltip"></div>
      </div>
      <div class="price-chart-axis">
        <span>{{ c.start_date }}</span>
        <span>最高 {{ c.max_display }} ・ 最安 {{ c.min_display }}</span>
        <span>{{ c.end_date }}</span>
      </div>
    </div>
    {% endif %}
  {% endmacro %}

  {% macro analysis_details(t) %}
      {{ price_chart(t.chart, t.name) }}

      <p class="reasoning">{{ t.reasoning }}</p>

      {% if t.key_factors %}
      <ul class="factors">
        {% for factor in t.key_factors %}
        <li>{{ factor }}</li>
        {% endfor %}
      </ul>
      {% endif %}

      {% if t.risks %}
      <p class="risks"><span class="label">留意点:</span> {{ t.risks }}</p>
      {% endif %}

      {% if t.reflection %}
      <p class="reflection">🔁 前回からの振り返り: {{ t.reflection }}</p>
      {% endif %}

      {% if t.news %}
      <details class="news-detail">
        <summary>関連ニュース（{{ t.news|length }}件）</summary>
        <ul>
          {% for article in t.news %}
          <li><a href="{{ article.link }}" target="_blank" rel="noopener">{{ article.title }}</a></li>
          {% endfor %}
        </ul>
      </details>
      {% endif %}
  {% endmacro %}

  {% macro ticker_card(t, rank, id_prefix="ticker-") %}
    <details class="card status-{{ t.status_key }}" id="{{ id_prefix }}{{ t.symbol }}">
      <summary class="card-summary">
        <div class="cs-top">
          <div class="cs-title">
            <span class="rank">{{ rank }}</span>
            <span class="name">{{ t.name }}</span>
            <span class="symbol">{{ t.symbol }}</span>
          </div>
          <div class="cs-status">
            <span class="status-chip"><span class="status-dot"></span>{{ t.status_icon }} {{ t.recommendation }}</span>
            <span class="cs-score">{{ t.score_display }}</span>
          </div>
        </div>
        <div class="cs-meta">
          {% if t.horizon %}<span class="horizon-tag">{{ t.horizon }}</span>{% endif %}
          {% if t.yutai %}
          <span><span class="label">最低投資</span>{{ t.yutai.min_investment_display }}{% if t.yutai.within_budget is false %}（予算超）{% endif %}</span>
          {% endif %}
          {% if t.top_member %}
          <span class="cs-pick"><span class="label">業種内の注目</span>{{ t.top_member.name }} <strong>{{ t.top_member.score_display }}</strong></span>
          {% endif %}
          {% if t.price_available %}
          <span><span class="label">前日比</span>{{ t.change_1d }}</span>
          <span><span class="label">1ヶ月</span>{{ t.change_1m }}</span>
          <span><span class="label">1年</span>{{ t.change_1y }}</span>
          {% endif %}
        </div>
        <p class="cs-reason">{{ t.reasoning }}</p>
        <span class="cs-toggle" aria-hidden="true"></span>
      </summary>

      <div class="card-body">
        <div class="tag-row">
          {% if t.market %}<span class="market-tag">{{ t.market }}</span>{% endif %}
          {% if t.theme %}<span class="theme-tag">{{ t.theme }}</span>{% endif %}
          {% if t.nisa_tag %}<span class="nisa-tag">{{ t.nisa_tag }}</span>{% endif %}
        </div>

        {% if t.price_available %}
        <div class="price-grid">
          <span><span class="label">現在値</span>{{ t.latest_close_display }}</span>
          <span><span class="label">前日比</span>{{ t.change_1d }}</span>
          <span><span class="label">1週間</span>{{ t.change_1w }}</span>
          <span><span class="label">1ヶ月</span>{{ t.change_1m }}</span>
          <span><span class="label">3ヶ月</span>{{ t.change_3m }}</span>
          <span><span class="label">6ヶ月</span>{{ t.change_6m }}</span>
          <span><span class="label">1年</span>{{ t.change_1y }}</span>
        </div>
        {% endif %}

        {% if t.subscores %}
        <p class="subscores">
          <span class="label">スコアの内訳</span>
          {% for s in t.subscores %}<span class="subscore"><span class="label">{{ s.label }}</span><span class="gain-{{ s.sign }}">{{ s.display }}</span></span>{% endfor %}
        </p>
        {% endif %}

        {% if t.yutai %}
        <div class="yutai-box">
          <div class="yutai-content"><span class="label">🎁 優待:</span>{{ t.yutai.content }}</div>
          <div class="yutai-stats">
            <div>
              <span class="label">最低投資金額（{{ t.yutai.shares }}株）</span>
              {{ t.yutai.min_investment_display }}
              {% if t.yutai.within_budget is not none %}<span class="yutai-flag">{{ "予算内" if t.yutai.within_budget else "予算オーバー" }}</span>{% endif %}
            </div>
            <div>
              <span class="label">権利確定月</span>
              {{ t.yutai.months_display }}末
              {% if t.yutai.next_record_display %}<span class="yutai-flag">次回 {{ t.yutai.next_record_display }}{% if t.yutai.next_record_is_this_month %}（今月）{% endif %}</span>{% endif %}
            </div>
            {% if t.yutai.yield_display %}
            <div>
              <span class="label">優待利回り（年間の目安）</span>
              {{ t.yutai.yield_display }}
            </div>
            {% endif %}
            {% if t.yutai.range_position_pct is not none %}
            <div>
              <span class="label">1年の値幅の中での位置</span>
              {{ t.yutai.range_label }}（{{ t.yutai.range_position_pct }}%）
              <div class="range-meter" role="img" aria-label="1年の最安値を0%、最高値を100%としたときの現在位置: {{ t.yutai.range_position_pct }}%">
                <span class="range-meter-dot" style="left: {{ t.yutai.range_position_pct }}%;"></span>
              </div>
              <div class="range-meter-ends"><span>1年の最安値</span><span>最高値</span></div>
            </div>
            {% endif %}
          </div>
          {% if t.yutai.source or t.yutai.link %}
          <p class="yutai-source">
            {% if t.yutai.source %}出典: {{ t.yutai.source }}{% endif %}
            {% if t.yutai.link %}<a href="{{ t.yutai.link }}" target="_blank" rel="noopener">優待の詳細を見る</a>{% endif %}
          </p>
          {% endif %}
        </div>
        {% endif %}

        {% if t.members %}
        <div class="member-block">
          <h4 class="member-heading">業種内の主な銘柄（AIスコア順）</h4>
          <p class="member-note">この業種の代表的な大型株を、AIが個別に判定した結果です。押すと理由とチャートが開きます。</p>
          <div class="card-list">
            {% for m in t.members %}
              {{ ticker_card(m, loop.index, "member-") }}
            {% endfor %}
          </div>
        </div>
        {% endif %}

        {{ analysis_details(t) }}
      </div>
    </details>
  {% endmacro %}

  {% macro holding_card(h) %}
    <details class="card status-{{ h.status_key }}" id="holding-{{ h.symbol }}-{{ h.purchase_date }}">
      <summary class="card-summary">
        <div class="cs-top">
          <div class="cs-title">
            <span class="name">{{ h.name }}</span>
            <span class="symbol">{{ h.symbol }}</span>
          </div>
          <div class="cs-status">
            <span class="status-chip"><span class="status-dot"></span>{{ h.status_icon }} {{ h.recommendation }}</span>
          </div>
        </div>
        <div class="cs-meta">
          <span><span class="label">含み損益</span><strong class="cs-gain {{ h.gain_class }}">{{ h.gain_loss_display }}</strong></span>
          <span><span class="label">現在値</span>{{ h.latest_close_display }}</span>
          <span><span class="label">取得単価</span>{{ h.purchase_price_display }}</span>
          <span><span class="label">保有</span>{{ h.holding_days if h.holding_days is not none else "—" }}日</span>
        </div>
        <p class="cs-reason">{{ h.reasoning }}</p>
        <span class="cs-toggle" aria-hidden="true"></span>
      </summary>

      <div class="card-body">
        <div class="price-grid">
          <span><span class="label">購入日</span>{{ h.purchase_date or "—" }}</span>
          <span><span class="label">前日比</span>{{ h.change_1d }}</span>
          <span><span class="label">1週間</span>{{ h.change_1w }}</span>
          <span><span class="label">1ヶ月</span>{{ h.change_1m }}</span>
          <span><span class="label">3ヶ月</span>{{ h.change_3m }}</span>
          <span><span class="label">6ヶ月</span>{{ h.change_6m }}</span>
          <span><span class="label">1年</span>{{ h.change_1y }}</span>
        </div>

        {{ analysis_details(h) }}
      </div>
    </details>
  {% endmacro %}

  {% macro card_list(items, empty_message) %}
    {% if items %}
    <div class="card-list">
      {% for t in items %}
        {{ ticker_card(t, loop.index) }}
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-note">{{ empty_message }}</p>
    {% endif %}
  {% endmacro %}

  {% macro summary_items(items, side) %}
    {% for t in items %}
    <li>
      <a class="summary-link" href="#{{ t.anchor_id }}">
        <span class="summary-score {{ side }}">{{ t.score_display }}</span>
        <span class="summary-name">{{ t.name }}</span>
        <span class="summary-group">{{ t.group }}</span>
      </a>
    </li>
    {% endfor %}
  {% endmacro %}

  {% macro summary_list(items, side) %}
    {% if items %}
    <ul class="summary-list">{{ summary_items(items, side) }}</ul>
    {% else %}
    <p class="summary-empty">本日は該当する銘柄がありません。</p>
    {% endif %}
  {% endmacro %}

  <p class="cards-hint">各銘柄のカードは押すと開き、チャート・判定の理由・ニュースが表示されます。</p>

  <section id="summary">
    <h2>AIによる売買サマリー</h2>
    {% for s in summary_sections %}
    <div class="summary-horizon" id="summary-{{ s.key }}">
      <h3 class="summary-horizon-title">{{ s.label }}</h3>
      <p class="summary-horizon-note">{{ s.note }}</p>
      <div class="summary-grid">
        <div>
          <h4 class="summary-heading buy">▲ 買い候補 <span class="summary-count">{{ s.buy|length }}件</span></h4>
          {{ summary_list(s.buy, "buy") }}
        </div>
        <div>
          <h4 class="summary-heading sell">▼ 売り候補 <span class="summary-count">{{ s.sell|length }}件</span></h4>
          {{ summary_list(s.sell, "sell") }}
        </div>
      </div>
    </div>
    {% endfor %}
    <p class="summary-note">ウォッチリスト・注目テーマ銘柄・暗号資産・株主優待銘柄・業種の代表銘柄の中から、スコアが±{{ summary_min_abs_score }}以上のものを、期間ごとに買い候補は上位{{ summary_max_buy_items }}件、売り候補は上位{{ summary_max_sell_items }}件まで載せています（業種別ETFと保有銘柄は除く）。そのほかの銘柄は各セクションで見られます。銘柄名を押すと、その銘柄のカードが開きます。</p>
  </section>

  <section id="holdings">
    <h2>保有銘柄の売却タイミング <span class="h2-count">{{ holdings|length }}件</span></h2>

    {% if profit_taking %}
    <details class="section-note warn">
      <summary>💰 利確優先モード適用中（{{ profit_taking.until }}まで・残り{{ profit_taking.days_left }}日）</summary>
      含み益が出ている銘柄は、今後の値下がりが見込まれる材料が少しでもあればAIが「売却検討」と
      判定するように設定しています。含み損の銘柄は通常どおりの判断です。
      期限を過ぎると自動で通常の判断に戻ります（設定は <code>config/sell_policy.yaml</code>）。
    </details>
    {% endif %}

    {% if holdings %}
    <div class="card-list">
      {% for h in holdings %}
        {{ holding_card(h) }}
      {% endfor %}
    </div>
    {% else %}
    <p class="empty-note">
      まだ保有銘柄が登録されていません。<code>config/portfolio.yaml</code> に購入した銘柄・購入日・購入価格を登録すると、ここに売却タイミングの判断が表示されます。
    </p>
    {% endif %}

    {% if theme_allocation or nisa_usage or tsumitate_usage %}
    <h3 class="sub-heading">配分とNISA枠</h3>
    {% endif %}

    {% if theme_allocation %}
    <div class="allocation-box">
      <h3>テーマ別配分</h3>
      {% for a in theme_allocation %}
      <div class="allocation-row">
        <span class="allocation-label">{{ a.theme }}</span>
        <div class="score-track"><div class="score-fill" style="width: {{ a.pct }}%;"></div></div>
        <span class="allocation-amount">{{ "%.1f"|format(a.pct) }}%</span>
      </div>
      {% endfor %}
      {% if theme_allocation_excluded_count %}
      <p class="allocation-note">
        投資金額（amount_invested_jpy）が未入力の保有銘柄が{{ theme_allocation_excluded_count }}件あり、この集計から除外されています。
      </p>
      {% endif %}
    </div>
    {% endif %}

    {% if nisa_usage %}
    <div class="allocation-box">
      <h3>NISA成長投資枠の使用状況（概算）</h3>
      <div class="allocation-row">
        <span class="allocation-label">{{ nisa_usage.current_year }}年の年間枠</span>
        <div class="score-track"><div class="score-fill" style="width: {{ nisa_usage.annual_pct }}%;"></div></div>
        <span class="allocation-amount">¥{{ "{:,.0f}".format(nisa_usage.annual_used) }} / ¥{{ "{:,.0f}".format(nisa_usage.annual_limit) }}</span>
      </div>
      <div class="allocation-row">
        <span class="allocation-label">生涯投資枠（成長投資枠の上限1,200万円分）</span>
        <div class="score-track"><div class="score-fill" style="width: {{ nisa_usage.lifetime_pct }}%;"></div></div>
        <span class="allocation-amount">¥{{ "{:,.0f}".format(nisa_usage.lifetime_used) }} / ¥{{ "{:,.0f}".format(nisa_usage.lifetime_limit) }}</span>
      </div>
      <p class="allocation-note">
        このアプリに登録した購入情報のみに基づく概算です（すべてNISA成長投資枠での購入という前提で計算しています）。
        正式な枠の消化状況は必ず証券会社側でご確認ください。
        {% if nisa_usage.excluded_count %}投資金額が未入力の保有銘柄が{{ nisa_usage.excluded_count }}件あり、この集計から除外されています。{% endif %}
      </p>
    </div>
    {% endif %}

    {% if tsumitate_usage %}
    <div class="allocation-box">
      <h3>NISAつみたて投資枠の使用状況（概算）</h3>
      <div class="allocation-row">
        <span class="allocation-label">{{ tsumitate_usage.current_year }}年の年間枠</span>
        <div class="score-track"><div class="score-fill" style="width: {{ tsumitate_usage.annual_pct }}%;"></div></div>
        <span class="allocation-amount">¥{{ "{:,.0f}".format(tsumitate_usage.annual_used) }} / ¥{{ "{:,.0f}".format(tsumitate_usage.annual_limit) }}</span>
      </div>
      <div class="allocation-row">
        <span class="allocation-label">生涯投資枠 合計（成長投資枠＋つみたて投資枠）</span>
        <div class="score-track"><div class="score-fill" style="width: {{ tsumitate_usage.combined_lifetime_pct }}%;"></div></div>
        <span class="allocation-amount">¥{{ "{:,.0f}".format(tsumitate_usage.combined_lifetime_used) }} / ¥{{ "{:,.0f}".format(tsumitate_usage.combined_lifetime_limit) }}</span>
      </div>

      {% if tsumitate_usage.suggested_monthly_to_fill_annual %}
      <p class="allocation-note">
        {% if tsumitate_usage.has_entries %}
        今のペースのまま{{ tsumitate_usage.current_year }}年の年間枠（120万円）を使い切るには、
        {% else %}
        まだ積立の登録がありません。仮に今から{{ tsumitate_usage.current_year }}年の年間枠（120万円）を
        使い切ろうとする場合、
        {% endif %}
        残り{{ tsumitate_usage.months_remaining_this_year }}ヶ月、月あたり目安
        <strong>¥{{ "{:,.0f}".format(tsumitate_usage.suggested_monthly_to_fill_annual) }}</strong>
        の積立が必要な計算になります（単純な残り枠÷残り月数の目安であり、必ず埋めるべきという
        意味ではありません）。
      </p>
      {% endif %}

      <details class="note-detail">
        <summary>ℹ️ この計算の注意点</summary>
        <code>config/nisa_tsumitate.yaml</code> に登録した積立設定（開始日・月額）のみに基づく
        概算です。証券会社側の正式な消化額とは異なる場合があるため、必ず証券会社側でご確認ください。
        年間枠を使い切ることを推奨するものではなく、あくまで目安の計算です。
        {% if tsumitate_usage.excluded_count %}日付や金額が不正な登録が{{ tsumitate_usage.excluded_count }}件あり、この集計から除外されています。{% endif %}
      </details>

      <details class="note-detail">
        <summary>つみたて投資枠の対象になりやすいファンドの種類（一般的な分類の例）</summary>
        <p class="allocation-note">
          特定の商品名を推奨するものではなく、あくまで一般的に知られている資産クラスの
          分類です。実際にどれを選ぶかは、ご自身のリスク許容度や目的に応じて証券会社等で
          ご確認ください。
        </p>
        <ul>
          <li><strong>全世界株式（オール・カントリー）型</strong>: 先進国・新興国を含む世界中の株式に、
            1本でまとめて分散投資するタイプ。特定の国・地域への依存度を下げたい場合に選ばれます。</li>
          <li><strong>米国株式（S&amp;P500など）型</strong>: 米国の主要企業に集中投資するタイプ。
            過去の実績は良好な一方、米国一国への集中度が高くなります。</li>
          <li><strong>先進国株式型</strong>: 米国を含む先進国の株式に分散投資するタイプ。
            新興国を含む全世界型より値動きがやや穏やかになりやすい傾向があります。</li>
          <li><strong>バランス型</strong>: 株式だけでなく債券・REIT等にも分散するタイプ。
            値動きの幅を抑えたい場合に選ばれますが、期待リターンも抑えめになりやすい傾向があります。</li>
          <li><strong>国内株式型</strong>: 日本国内の株式に投資するタイプ。為替変動の影響を受けにくい
            一方、日本経済への依存度が高くなります。</li>
        </ul>
      </details>
    </div>
    {% endif %}
  </section>

  <section id="sectors">
    <h2>業種別の強さ（TOPIX-17業種ETF） <span class="h2-count">{{ sectors|length }}業種</span></h2>
    <details class="section-note info">
      <summary>📊 全17業種を、AIが同じ物差しでスコア順に比較しています</summary>
      東証の上場企業を17の業種に分け、業種全体の値動きに連動するETFをAIがスコア付けし、強そうな順に並べています。
      ほかのセクションは人が選んだ銘柄なので分野が偏りますが、ここでは全業種を偏りなく比べられます。
      <ul>
        <li>これらのETFは1日の売買量が少なく、買値と売値の差が広がりやすいです。実際に売買するよりも、「どの業種が強そうか」を見る物差しとして使うことを想定しています。</li>
        <li>強そうな業種が見つかったら、その業種の個別銘柄を調べるきっかけにしてください。</li>
      </ul>
    </details>
    {{ card_list(sectors, "業種別ETFが登録されていません。config/sectors.yaml に登録すると、ここに表示されます。") }}
  </section>

  <section id="yutai">
    <h2>株主優待銘柄（少額で買える優待株） <span class="h2-count">{{ yutai|length }}件</span></h2>
    <details class="section-note info">
      <summary>🎁 優待は原則100株以上が対象です（単元未満株では原則もらえません）</summary>
      株主優待がある銘柄の中から、少ない金額で買えるものを集め、株価そのものの上昇が見込めるかをAIがスコア順に整理しています。
      <ul>
        <li><strong>優待は原則100株（単元株）以上が対象です。</strong>単元未満株（1株単位・金額指定）での購入では、ほぼすべての銘柄で優待はもらえません。</li>
        <li>権利確定月の末日に株主名簿に載っている必要があります。実際には、その2営業日前の「権利付き最終日」までに買っておく必要があります。</li>
        <li>権利確定日の直後（権利落ち日）は、優待目当ての売りで株価が下がりやすい傾向があります。</li>
        <li>「1年の値幅の中での位置」は、1年間の最安値を0%、最高値を100%としたときの今の株価の位置です。安値圏でも、下がり続けている途中のこともあります。</li>
        <li>優待内容は{{ yutai_checked_on or "登録時" }}時点の確認内容です。変更・廃止されることがあるため、購入前に各社のIRサイトで最新情報を確認してください。{% if yutai_budget_display %}「予算内」は最低投資金額が{{ yutai_budget_display }}以下かどうかの目安です。{% endif %}</li>
      </ul>
    </details>
    {% if yutai %}
    {% set yutai_buy = yutai|selectattr("recommendation", "equalto", "買い候補")|list %}
    {% set yutai_rest = yutai|rejectattr("recommendation", "equalto", "買い候補")|list %}
    <h3 class="sub-heading buy-heading">▲ 買い候補 <span class="summary-count">{{ yutai_buy|length }}件</span></h3>
    {{ card_list(yutai_buy, "本日、買い候補と判定された優待銘柄はありません。") }}
    {% if yutai_rest %}
    <details class="group-more">
      <summary>様子見・売り候補の優待銘柄（{{ yutai_rest|length }}件）を表示</summary>
      {{ card_list(yutai_rest, "") }}
    </details>
    {% endif %}
    {% else %}
    <p class="empty-note">株主優待銘柄が登録されていません。config/yutai.yaml に銘柄を登録すると、ここに表示されます。</p>
    {% endif %}
  </section>

  <section id="watchlist">
    <h2>ウォッチリスト（スコア順） <span class="h2-count">{{ tickers|length }}件</span></h2>
    {{ card_list(tickers, "ウォッチリストに銘柄が登録されていません。") }}
  </section>

  <section id="candidates">
    <h2>注目テーマ銘柄（ハイリスク候補） <span class="h2-count">{{ candidates|length }}件</span></h2>
    <details class="section-note warn">
      <summary>⚠ 値動きが大きいハイリスク銘柄です</summary>
      このセクションは、世界情勢・マクロ経済ニュースをもとにAIが値動きの大きいテーマ株・成長株の中から
      注目度を整理したものです。通常の銘柄よりも価格変動が大きく、短期的に大きく下落する可能性もあります。
      投資対象として検討する場合は特に慎重に判断してください。
    </details>
    {{ card_list(candidates, "候補銘柄が登録されていません。") }}
  </section>

  <section id="crypto">
    <h2>暗号資産 <span class="h2-count">{{ crypto|length }}件</span></h2>
    <details class="section-note warn">
      <summary>⚠ 株式とは別の資産クラスで、NISAの対象外です</summary>
      株式とは異なる資産クラスで、価格変動が非常に大きく、NISA成長投資枠の対象にもなりません。
      楽天証券のような証券会社では購入できず、暗号資産交換業者（楽天ウォレット等）の口座が別途必要です。
    </details>
    {{ card_list(crypto, "暗号資産の候補銘柄が登録されていません。") }}
  </section>

  <section id="news">
    <h2>世界情勢・マクロ経済ニュース</h2>
    {% if macro_news %}
    <ul class="macro-list">
      {% for article in macro_news[:5] %}
      <li>
        <a href="{{ article.link }}" target="_blank" rel="noopener">{{ article.title }}</a>
        <div class="macro-source">{{ article.source }}{% if article.published %} ・ {{ article.published }}{% endif %}</div>
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p class="empty-note">本日はマクロ経済ニュースを取得できませんでした。</p>
    {% endif %}
  </section>

  <section id="accuracy">
    <h2>AIの的中率（過去の判定の検証）</h2>
    <details class="section-note">
      <summary>ℹ️ 検証方法</summary>
      「買い候補」「売り候補」「売却検討」の判定を、その後の株価と比較し、判定の方向（上昇/下落）と
      実際の値動きが一致していれば「的中」、逆であれば「不的中」として集計しています。
      比較するタイミングは、短期の判定と保有銘柄の判定は30日後、中長期の判定は180日後です。
      変化率が±1%以内の場合は判定なし（様子見扱い）として集計から除外します。
    </details>

    {% if accuracy.overall_sample_size %}
    <div class="allocation-box">
      <h3>全体の的中率</h3>
      <div class="score-row">
        <div class="score-value">{{ "%.0f"|format(accuracy.overall_accuracy_pct) }}%</div>
        <div class="score-track"><div class="score-fill" style="width: {{ accuracy.overall_accuracy_pct }}%;"></div></div>
      </div>
      <p class="allocation-note">
        検証済み {{ accuracy.overall_sample_size }}件（様子見扱い{{ accuracy.overall_neutral }}件を除く）・
        検証待ち {{ accuracy.pending_count }}件（短期は30日後・中長期は180日後に確定します）
      </p>
      {% for h in accuracy.horizon_breakdown %}
      <div class="allocation-row">
        <span class="allocation-label">期間: {{ h.horizon }}</span>
        {% if h.accuracy_pct is not none %}
        <div class="score-track"><div class="score-fill" style="width: {{ h.accuracy_pct }}%;"></div></div>
        <span class="allocation-amount">{{ "%.0f"|format(h.accuracy_pct) }}%（{{ h.sample_size }}件）</span>
        {% else %}
        <div class="score-track"><div class="score-fill" style="width: 0%;"></div></div>
        <span class="allocation-amount">データなし</span>
        {% endif %}
      </div>
      {% endfor %}

      {% for b in accuracy.breakdown %}
      <div class="allocation-row">
        <span class="allocation-label">{{ b.recommendation }}</span>
        {% if b.accuracy_pct is not none %}
        <div class="score-track"><div class="score-fill" style="width: {{ b.accuracy_pct }}%;"></div></div>
        <span class="allocation-amount">{{ "%.0f"|format(b.accuracy_pct) }}%（{{ b.sample_size }}件）</span>
        {% else %}
        <div class="score-track"><div class="score-fill" style="width: 0%;"></div></div>
        <span class="allocation-amount">データなし</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>

    {% if accuracy.accuracy_since_improvement.sample_size %}
    <div class="allocation-box">
      <h3>改善施策後の的中率（{{ accuracy.accuracy_since_improvement.cohort_start }}以降に記録した判定のみ）</h3>
      <div class="score-row">
        <div class="score-value">{{ "%.0f"|format(accuracy.accuracy_since_improvement.accuracy_pct) }}%</div>
        <div class="score-track"><div class="score-fill" style="width: {{ accuracy.accuracy_since_improvement.accuracy_pct }}%;"></div></div>
      </div>
      <p class="allocation-note">
        検証済み {{ accuracy.accuracy_since_improvement.sample_size }}件
        （様子見扱い{{ accuracy.accuracy_since_improvement.neutral }}件を除く）
      </p>
      <details class="note-detail">
        <summary>ℹ️ この数字の見方</summary>
        判定の確定には30日かかるため、上の「全体の的中率」には検証期間の延長・確信度基準の
        見直し・銘柄別の連続外れ検知といった改善策の導入前に記録された判定が多く含まれ、
        改善の効果がすぐには反映されません。ここでは改善策の導入日以降に記録された判定だけを
        別集計し、実際に効果が出ているかを早めに確認できるようにしています。
      </details>
    </div>
    {% endif %}

    {% if accuracy.simulated_pl.overall_trade_count %}
    <div class="allocation-box">
      <h3>シミュレーション損益（判定通りに行動していた場合）</h3>
      <div class="kv-row kv-total">
        <span class="kv-label">全シグナル平均リターン（1件あたり・{{ accuracy.simulated_pl.overall_trade_count }}件）</span>
        <strong class="kv-value">{{ "%+.2f"|format(accuracy.simulated_pl.overall_avg_return_pct) }}%</strong>
      </div>
      {% for s in accuracy.simulated_pl.by_recommendation %}
      <div class="kv-row">
        <span class="kv-label">{{ s.recommendation }}</span>
        {% if s.avg_return_pct is not none %}
        <span class="kv-value">
          <strong>{{ "%+.2f"|format(s.avg_return_pct) }}%</strong>
          <span class="kv-sub">{{ s.trade_count }}件中 プラス{{ s.wins }}・マイナス{{ s.losses }}</span>
        </span>
        {% else %}
        <span class="kv-value">データなし</span>
        {% endif %}
      </div>
      {% endfor %}
      <details class="note-detail">
        <summary>ℹ️ この数字の見方</summary>
        「買い候補」は判定時に買って検証時点（短期30日後・中長期180日後）に売った場合、
        「売り候補」「売却検討」は判定時に売った/買わなかった場合の仮想リターンです。等金額・単利（複利なし）で手数料や税金は
        考慮していません。特定の売買を推奨するものではなく、あくまで判定を機械的に採用し
        続けた場合の振り返り指標です。
      </details>
    </div>
    {% endif %}

    {% if accuracy.recent_resolved %}
    <details class="news-detail">
      <summary>直近の検証結果（{{ accuracy.recent_resolved|length }}件）</summary>
      <ul>
        {% for r in accuracy.recent_resolved %}
        <li>
          {{ r.date }} {{ r.name }}（{{ r.symbol }}）: {{ r.recommendation }} →
          {{ "%+.2f"|format(r.change_pct) }}%
          {% if r.outcome == "correct" %}✅ 的中{% elif r.outcome == "incorrect" %}❌ 不的中{% else %}― 様子見扱い{% endif %}
          {% if r.sim_return_pct is not none %}（仮想リターン {{ "%+.2f"|format(r.sim_return_pct) }}%）{% endif %}
        </li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}
    {% else %}
    <p class="empty-note">
      検証にはまず判定から30日以上の経過が必要です。今後の判定が蓄積され次第、ここに的中率が表示されます
      （検証待ち: {{ accuracy.pending_count }}件）。
    </p>
    {% endif %}
  </section>

  <footer>
    このページはGitHub ActionsとGemini APIにより自動生成されています。個人利用目的の参考情報です。
  </footer>

</div>
<button type="button" class="back-to-top" id="back-to-top" aria-label="ページの一番上へ戻る" title="一番上へ">▲</button>
<script>
  (function () {
    function fmt(v) {
      return v >= 1000
        ? v.toLocaleString("ja-JP", { maximumFractionDigits: 0 })
        : v.toLocaleString("ja-JP", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    document.querySelectorAll(".price-chart").forEach(function (chart) {
      var points = JSON.parse(chart.dataset.points);
      var viewHeight = Number(chart.dataset.height);
      var plot = chart.querySelector(".price-chart-plot");
      var cross = plot.querySelector(".chart-crosshair");
      var dot = plot.querySelector(".chart-dot");
      var tip = plot.querySelector(".chart-tooltip");
      var last = points.length - 1;
      var current = last;

      function show(index) {
        current = Math.max(0, Math.min(last, index));
        var p = points[current];
        var rect = plot.getBoundingClientRect();
        var x = current / last * rect.width;
        var y = p[2] / viewHeight * rect.height;
        cross.style.left = x + "px";
        dot.style.left = x + "px";
        dot.style.top = y + "px";
        tip.textContent = "";
        var value = document.createElement("strong");
        value.textContent = fmt(p[1]);
        var date = document.createElement("span");
        date.textContent = p[0];
        tip.appendChild(value);
        tip.appendChild(date);
        cross.style.display = dot.style.display = tip.style.display = "block";
        var half = tip.offsetWidth / 2;
        tip.style.left = Math.max(half, Math.min(rect.width - half, x)) + "px";
      }
      function hide() {
        cross.style.display = dot.style.display = tip.style.display = "none";
      }
      function indexAt(clientX) {
        var rect = plot.getBoundingClientRect();
        return Math.round((clientX - rect.left) / rect.width * last);
      }
      plot.addEventListener("pointermove", function (e) { show(indexAt(e.clientX)); });
      plot.addEventListener("pointerdown", function (e) { show(indexAt(e.clientX)); });
      plot.addEventListener("pointerleave", hide);
      plot.addEventListener("focus", function () { show(current); });
      plot.addEventListener("blur", hide);
      plot.addEventListener("keydown", function (e) {
        if (e.key === "ArrowLeft") { show(current - 1); e.preventDefault(); }
        if (e.key === "ArrowRight") { show(current + 1); e.preventDefault(); }
      });
    });
  })();
  (function () {
    // サマリーの銘柄名などから「#ticker-…」へ飛んだとき、折りたたまれたカードを開く。
    // クリック時の処理はページ内移動より先に動くので、開いてからその位置へスクロールされる。
    function openTarget(hash) {
      if (!hash || hash.length < 2) return;
      var el = document.getElementById(decodeURIComponent(hash.slice(1)));
      // カード自身に加え、カードを包む「…を表示」の折りたたみも開く
      for (var node = el; node; node = node.parentElement) {
        if (node.tagName === "DETAILS") node.open = true;
      }
    }
    document.addEventListener("click", function (e) {
      var link = e.target.closest('a[href^="#"]');
      if (link) openTarget(link.getAttribute("href"));
    });
    window.addEventListener("hashchange", function () { openTarget(location.hash); });
    openTarget(location.hash);
  })();
  (function () {
    // 目次バーで、いま画面に表示しているセクションを強調する
    var nav = document.getElementById("section-nav");
    if (!nav || !("IntersectionObserver" in window)) return;
    var links = {};
    nav.querySelectorAll("a").forEach(function (a) { links[a.getAttribute("href").slice(1)] = a; });
    var visible = {};
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) { visible[entry.target.id] = entry.isIntersecting; });
      var current = null;
      document.querySelectorAll("section[id]").forEach(function (s) {
        if (!current && visible[s.id]) current = s.id;
      });
      Object.keys(links).forEach(function (id) {
        links[id].classList.toggle("active", id === current);
        if (id === current) links[id].setAttribute("aria-current", "true");
        else links[id].removeAttribute("aria-current");
      });
      if (current && links[current]) {
        var a = links[current];
        var left = a.offsetLeft - nav.clientWidth / 2 + a.offsetWidth / 2;
        nav.scrollTo({ left: left, behavior: "smooth" });
      }
    }, { rootMargin: "-64px 0px -55% 0px" });
    document.querySelectorAll("section[id]").forEach(function (s) { observer.observe(s); });
  })();
  (function () {
    var button = document.getElementById("back-to-top");
    window.addEventListener("scroll", function () {
      button.classList.toggle("visible", window.scrollY > 400);
    }, { passive: true });
    button.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  })();
  (function () {
    // ホーム画面アプリには再読み込みボタンがなく、開き直しても前回の画面が
    // メモリから復元されるだけのことがある。読み込みから30分以上たって
    // 画面に戻ってきたら、最新のレポートを取り直す。
    var STALE_MS = 30 * 60 * 1000;
    var loadedAt = Date.now();
    function reloadIfStale() {
      if (document.visibilityState === "visible" && Date.now() - loadedAt > STALE_MS) {
        location.reload();
      }
    }
    document.addEventListener("visibilitychange", reloadIfStale);
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) reloadIfStale();
    });
  })();
  (function () {
    var root = document.documentElement;
    var key = "invest-dashboard-theme";
    var saved = localStorage.getItem(key);
    if (saved) root.setAttribute("data-theme", saved);
    document.getElementById("theme-toggle").addEventListener("click", function () {
      var current = root.getAttribute("data-theme");
      var next = current === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      localStorage.setItem(key, next);
    });
  })();
</script>
</body>
</html>
